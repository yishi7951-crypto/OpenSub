--- a/ggml/src/ggml-cpu/arch/x86/quants.c
+++ b/ggml/src/ggml-cpu/arch/x86/quants.c
@@ -4106,3 +4106,68 @@ void ggml_vec_dot_iq4_xs_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const v
     ggml_vec_dot_iq4_xs_q8_K_generic(n, s, bs, vx, bx, vy, by, nrc);
 #endif
 }
+
+void ggml_vec_dot_stq1_0_q8_K(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_stq1_0 * GGML_RESTRICT x = vx;
+    const block_q8_K  * GGML_RESTRICT y = vy;
+
+    const int nb = n / QK_K;
+
+#if defined(__AVX2__)
+    const __m256i cb_pos = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i *) stq1_0_codebook));
+    const __m256i cb_neg = _mm256_broadcastsi128_si256(_mm_loadu_si128((const __m128i *) (stq1_0_codebook + 16)));
+    const __m128i m4b    = _mm_set1_epi8(0x0F);
+    const __m256i m2b    = _mm256_set1_epi8(3);
+    const __m256i ones   = _mm256_set1_epi16(1);
+
+    float sumf = 0.0f;
+
+    // Same layout as the NEON path: each half covers 32 groups, one 128-bit lane per 64-byte chunk of y.
+    // A lane's patterns are 0/1/2 here, one above their real value; bsums takes that excess back off.
+#define STQ1_0_DOT_LANE(PACKS, SHIFT, P) do {                                             \
+    const __m256i lanes = _mm256_and_si256(_mm256_srli_epi16((PACKS), (SHIFT)), m2b);     \
+    const __m256i ys = MM256_SET_M128I(_mm_loadu_si128((const __m128i *) (yp + 64 + (P) * 16)), \
+                                       _mm_loadu_si128((const __m128i *) (yp + (P) * 16)));     \
+    sumi = _mm256_add_epi32(sumi, _mm256_madd_epi16(_mm256_maddubs_epi16(lanes, ys), ones));    \
+} while (0)
+
+    for (int i = 0; i < nb; ++i) {
+        __m256i sumi = _mm256_setzero_si256();
+
+        for (int half = 0; half < 2; ++half) {
+            const __m128i packed = _mm_loadu_si128((const __m128i *) (x[i].qs + half * 16));
+            const __m128i lo     = _mm_and_si128(packed, m4b);
+            const __m128i hi     = _mm_and_si128(_mm_srli_epi16(packed, 4), m4b);
+            const __m256i codes  = MM256_SET_M128I(_mm_unpackhi_epi8(lo, hi), _mm_unpacklo_epi8(lo, hi));
+            const __m256i packs  = _mm256_blendv_epi8(_mm256_shuffle_epi8(cb_pos, codes), _mm256_shuffle_epi8(cb_neg, codes),
+                                                      bytes_from_bits_32(x[i].sign + half * 4));
+            const int8_t * yp = y[i].qs + half * 128;
+
+            STQ1_0_DOT_LANE(packs, 0, 0);
+            STQ1_0_DOT_LANE(packs, 2, 1);
+            STQ1_0_DOT_LANE(packs, 4, 2);
+            STQ1_0_DOT_LANE(packs, 6, 3);
+        }
+
+        const __m256i bsums = _mm256_madd_epi16(_mm256_loadu_si256((const __m256i *) y[i].bsums), ones);
+        const int sum = hsum_i32_8(sumi) - hsum_i32_8(bsums);
+
+        sumf += (float) sum * (GGML_CPU_FP16_TO_FP32(x[i].d) * y[i].d);
+    }
+
+#undef STQ1_0_DOT_LANE
+
+    *s = sumf;
+#else
+    UNUSED(x);
+    UNUSED(y);
+    UNUSED(nb);
+    ggml_vec_dot_stq1_0_q8_K_generic(n, s, bs, vx, bx, vy, by, nrc);
+#endif
+}
